PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/farmlink?retryWrites=true&w=majority
# Optional: set this if Node.js cannot resolve the MongoDB SRV record with your system DNS.
# MONGODB_DNS_SERVERS=1.1.1.1
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional: set both values to provision one admin account at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
