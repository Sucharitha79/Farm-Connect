PORT=5000
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/farmlink?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CORS_ORIGIN=*
# Optional: set both values to provision one admin account at startup.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FarmLink <no-reply@example.com>
